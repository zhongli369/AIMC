# AIMC environment template.
# Copy this file to `.env` (gitignored) and fill in real values.
# NEVER commit `.env`.
#
# `electron/main.cjs` auto-loads `.env` from the project root (or cwd),
# so double-click launch keeps working without hardcoding any credentials.

# ── LLM providers (set only the ones you use) ─────────────
DEEPSEEK_API_KEY=
DOUBAO_API_KEY=            # Volcengine ARK inference (format: ark-...)
ARK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
QWEN_API_KEY=

# ── Doubao / Volcengine TTS (OpenSpeech) ────────────────
DOUBAO_TTS_ACCESS_KEY_ID=      # Volcengine IAM AccessKeyId (AKLT...)
DOUBAO_TTS_SECRET_ACCESS_KEY=  # Volcengine IAM SecretAccessKey
DOUBAO_TTS_API_KEY=            # TTS grant token (body.app.token)
DOUBAO_TTS_APP_ID=             # Volcengine TTS App ID

# ── TTS / Voice switches ────────────────────────────────
AIMC_TTS_ENABLED=1
AIMC_TTS_PROVIDER=doubao       # doubao | edge
AIMC_VOICE_ENABLED=1
AIMC_WHISPER_LANGUAGE=zh
AIMC_WHISPER_MODEL=tiny
